+# Copia este archivo como .env y llena los valores. Nunca subas el .env al repositorio.
+# En Easypanel, estas mismas variables van en el servicio de la app, pestaña Environment.
+
+NODE_ENV=production
+PORT=3000
+# Dirección pública con https, sin barra al final
+PUBLIC_URL=https://rnr.antpath.mx
+# Easypanel: copia la "Internal Connection URL" del servicio de Postgres
+DATABASE_URL=postgres://usuario:contrasena@rnr_db:5432/rnr
+# 64 caracteres hexadecimales. Genera uno con: openssl rand -hex 32
+SESSION_SECRET=
+# Carpeta para PDFs y fotos. En Docker es un volumen montado en /data
+STORAGE_DIR=/data
+
+# Primer dueño: se da de alta al arrancar el servidor
+OWNER_EMAIL=
+# Solo en desarrollo: entrar sin Google con este correo (prohibido en producción)
+# DEV_LOGIN_EMAIL=
+
+# Inicio de sesión con Google (Google Cloud > APIs y servicios > Credenciales > ID de cliente de OAuth, tipo "Aplicación web")
+# URI de redireccionamiento autorizado: https://rnr.antpath.mx/auth/google/callback
+GOOGLE_CLIENT_ID=
+GOOGLE_CLIENT_SECRET=
+
+# Claude (cuenta de Anthropic a nombre del cliente)
+ANTHROPIC_API_KEY=
+CLAUDE_MODEL=claude-sonnet-5-5
+
+# OpenRouter (opcional): otra vía a los modelos con una sola clave, útil como respaldo.
+# Basta con una de las dos claves (Anthropic u OpenRouter); con las dos, una respalda a la otra.
+OPENROUTER_API_KEY=
+# Nombre del modelo en OpenRouter. Debe aceptar salida estructurada (structured_outputs).
+OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
+# Cuál usar primero si están las dos claves: claude u openrouter (sin valor: claude)
+LLM_PROVIDER=
+# true: si el primero falla, intenta con el otro
+LLM_FALLBACK=true
+
+# Google Calendar con cuenta de servicio: el JSON completo de la llave, o el mismo JSON en base64.
+# El dueño comparte su calendario con el correo de la cuenta de servicio ("Hacer cambios en eventos").
+GOOGLE_SERVICE_ACCOUNT_JSON=
+# ID del calendario: normalmente el correo del dueño
+GOOGLE_CALENDAR_ID=
+
+# WhatsApp Cloud API (pendiente el alta en Meta). Sin estos valores la plataforma trabaja en modo prueba.
+WHATSAPP_TOKEN=
+WHATSAPP_PHONE_NUMBER_ID=
+WHATSAPP_APP_SECRET=
+# Texto que inventas tú y pegas también en Meta al registrar el webhook
+WHATSAPP_VERIFY_TOKEN=
+WHATSAPP_API_VERSION=v23.0
