 server/src/services/extraction.ts   | 78 +++++++++++++++++++++--------
 server/test/extraccion.test.ts      | 31 ++++++++++++
 3 files changed, 98 insertions(+), 24 deletions(-)

diff --git a/server/src/routes/conversaciones.ts b/server/src/routes/conversaciones.ts
