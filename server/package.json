{
  "name": "@rnr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/secure-session": "8.2.0",
    "@fastify/static": "8.2.0",
    "@rnr/shared": "*",
    "fastify": "5.6.1",
    "google-auth-library": "9.15.1",
    "mustache": "4.2.0",
    "pg": "8.16.3",
    "pg-boss": "10.3.2",
    "playwright": "1.63.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
